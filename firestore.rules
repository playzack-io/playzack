rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Profil, Bestwerte, Folgen, Läufe, Spielstand: lesen alle Angemeldeten, schreiben nur der Besitzer
    match /players/{uid} { allow read: if signedIn(); allow write: if isMe(uid); }
    match /follows/{uid} { allow read: if signedIn(); allow write: if isMe(uid); }
    match /runs/{uid} { allow read: if signedIn(); allow write: if isMe(uid); }
    match /saves/{uid} { allow read, write: if isMe(uid); }

    // Herausforderungen: anlegen nur als Absender, ändern nur Absender oder Empfänger
    match /challenges/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)
        && request.resource.data.from == resource.data.from && request.resource.data.to == resource.data.to;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Benutzernamen: jeder Name gehört genau einem Konto (uid). Alte kurze Sperren (holder/exp) dürfen übernommen werden.
    match /unames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && name.matches('^[a-z0-9_.]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid == request.auth.uid
        && (resource.data.get('uid', null) == request.auth.uid
          || (resource.data.get('uid', null) == null && (resource.data.get('holder', '') == request.auth.uid || resource.data.get('exp', 0) < request.time.toMillis())));
      allow delete: if signedIn() && resource.data.get('uid', null) == request.auth.uid;
    }

    // Turniere: eins pro Gastgeber, eine Teilnahme pro Spieler
    match /tourneys/{uid} { allow read: if signedIn(); allow write: if isMe(uid); }
    match /tentries/{uid} { allow read: if signedIn(); allow write: if isMe(uid); }

    // Chat: nur gegenseitige Freunde, nur Text bis 300 Zeichen
    function follows(a, b) { return exists(/databases/$(database)/documents/follows/$(a)) && b in get(/databases/$(database)/documents/follows/$(a)).data.ids; }
    function inChat(cid) { return signedIn() && cid.split('_').size() == 2 && (cid.split('_')[0] == request.auth.uid || cid.split('_')[1] == request.auth.uid); }
    function chatOther(cid) { return cid.split('_')[0] == request.auth.uid ? cid.split('_')[1] : cid.split('_')[0]; }
    function friends(cid) { return follows(request.auth.uid, chatOther(cid)) && follows(chatOther(cid), request.auth.uid); }
    match /chats/{cid} {
      allow read: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow create, update: if inChat(cid) && friends(cid)
        && request.resource.data.a == cid.split('_')[0] && request.resource.data.b == cid.split('_')[1]
        && request.resource.data.lastBy == request.auth.uid
        && request.resource.data.last is string && request.resource.data.last.size() <= 120;
      match /msgs/{mid} {
        allow read: if inChat(cid);
        allow create: if inChat(cid) && friends(cid) && request.resource.data.by == request.auth.uid
          && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 300
          && request.resource.data.keys().hasOnly(['by', 't', 'at']);
      }
    }
    // Clipper: Videos einreichen (Prüfung und Auszahlung in der Firebase-Konsole), eigene Einreichungen lesen
    match /clips/{id} {
      allow read: if signedIn() && resource.data.by == request.auth.uid;
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'plat', 'url', 'handle', 'at', 'status'])
        && request.resource.data.status == 'neu' && request.resource.data.plat in ['tt', 'ig']
        && request.resource.data.url is string && request.resource.data.url.size() <= 300
        && request.resource.data.handle is string && request.resource.data.handle.size() <= 30;
    }
    // Story-Skin: einmal pro Konto melden
    match /stories/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['by', 'handle', 'at']) && request.resource.data.by == uid
        && request.resource.data.handle is string && request.resource.data.handle.size() <= 30;
    }
    // Meldungen: nur anlegen, lesen nur in der Firebase-Konsole
    match /reports/{id} { allow create: if signedIn() && request.resource.data.by == request.auth.uid; }

    // Live-Räume: Anwesenheit und kurze Nachrichten
    match /rooms/{room}/peers/{peer} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.by == request.auth.uid;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }
    match /rooms/{room}/msgs/{msg} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }
  }
}
